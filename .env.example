# Copie este ficheiro para .env e preencha com os valores do seu projeto Supabase.
# O .env real está no .gitignore e nunca deve ser enviado para o GitHub.

# --- Servidor (SSR / rotas de servidor) ---
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Só no servidor. NUNCA usar prefixo VITE_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cliente (expostas no browser pelo Vite) ---
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
