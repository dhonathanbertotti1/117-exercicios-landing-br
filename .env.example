# Copie para .env e preencha. O .env real esta no .gitignore.

# ID do Meta Pixel. E publico (aparece no HTML), mas o servidor tambem
# precisa dele para a API de Conversoes.
META_PIXEL_ID=

# Token da API de Conversoes (Conversions API), gerado no Gestor de Eventos
# do Meta. E SEGREDO: so no servidor, nunca com prefixo VITE_.
# Sem ele o site funciona na mesma, apenas sem eventos server-side.
META_CAPI_ACCESS_TOKEN=
